# Copy to .env, fill in the values, and keep .env out of git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated numeric Telegram user IDs allowed to moderate.
TELEGRAM_MODERATOR_IDS=

# Dedicated PocketBase user with role=moderator (never use a superuser here).
PB_URL=http://127.0.0.1:8090
PB_MODERATOR_EMAIL=
PB_MODERATOR_PASSWORD=
# Use the frontend address reachable from the moderator's device.
SITE_URL=http://localhost:5173
