{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PB_URL": "http://127.0.0.1:8090",
    "TZ": "Europe/Minsk"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm ls *)",
      "Bash(npx tsc *)",
      "Bash(npx vite *)",
      "Bash(npx pocketbase-typegen *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(./pocketbase.exe *)",
      "Bash(./back/pocketbase.exe *)",
      "PowerShell(npm run *)",
      "PowerShell(npm ci)",
      "PowerShell(npx tsc *)",
      "PowerShell(npx vite *)",
      "PowerShell(npx pocketbase-typegen *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git stash *)",
      "PowerShell(.\\pocketbase.exe *)",
      "PowerShell(.\\back\\pocketbase.exe *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(npm uninstall *)",
      "Bash(npm remove *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm add *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npm remove *)",
      "Edit(back/pb_migrations/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
