# Production. Caddy serves the built frontend itself, using the precompressed .br / .gz files from the build
# (front/vite.config.ts, precompress), and proxies /api and the admin UI to PocketBase, compressing responses
# on the fly (PocketBase doesn't compress API responses).
#
# Environment:
#   SITE_ADDRESS — domain (default localhost: local check with a self-signed certificate)
#   PB_UPSTREAM  — PocketBase address (pocketbase:8090 in docker-compose)
#   SITE_ROOT    — frontend build directory (front/dist, same as pb_public)

{$SITE_ADDRESS:localhost} {
	# Up to 5 photos of 8 MB each per report
	request_body {
		max_size 45MB
	}

	@backend path /api/* /_/*
	handle @backend {
		encode zstd gzip
		reverse_proxy {$PB_UPSTREAM:127.0.0.1:8090} {
			# Realtime (SSE) keeps the connection open
			transport http {
				read_timeout 360s
			}
		}
	}

	handle {
		root * {$SITE_ROOT:/srv/site}

		# Hashed build files never change; the page and the service worker are revalidated every time
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"

		# SPA fallback
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}
}
